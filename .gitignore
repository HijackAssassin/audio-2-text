# Code\ is Audio2Text's git repository and the ONLY folder that goes on GitHub ("push to github.bat").
# Build\, Website\ and Resources\ are beside it, so they are never in it.

# Never public: keys, passwords, shared secrets (*.local.* / .env, with a blank *.example.* committed)
*.local.*
.env
.env.*
!.env.example

# Test audio stays in ..\Resources\testing (game audio - not ours to publish)
testing/

# Python environment, build output and caches
.venv/
build/
dist/
__pycache__/
*.pyc
*.spec
*.log
